# SQLite location (defaults to backend/data/fst-sisters.db)
# DB_FILE=C:\...\backend\data\fst-sisters.db

# Server
PORT=5000
NODE_ENV=production

# Auth secrets (required; generate strong random values)
JWT_SECRET=change-me
FST_PASSWORD_KEY=change-me

# Default demo credentials (shown on the login page in NON-production only).
# Supply them here so they never live in source code. Format: username/password, comma-separated.
DEMO_CREDENTIALS=username/password

# Supabase (source of truth)
# Project URL + service role key from Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Google Drive (OAuth refresh token flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Backups
BACKUP_KEEP=14
